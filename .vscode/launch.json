{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Playwright WebAPIPart1",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "playwright",
        "test",
        "tests/WebAPIPart1.spec.js",
        "--headed"
      ],
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
      "console": "internalConsole",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Playwright WebAPIPart2",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "playwright",
        "test",
        "tests/WebAPIPart2.spec.js",
        "--headed",
        "--debug"
      ],
      "console": "internalConsole",
      "internalConsoleOptions": "neverOpen"
    }
  ]
}
